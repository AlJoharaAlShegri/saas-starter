# {{PROJECT_NAME}} — environment template. Copy to .env.local and fill in. {{ENV_PREFIX}} = your framework client-exposure prefix (VITE_, NEXT_PUBLIC_, EXPO_PUBLIC_, ...); server-only vars get none.
{{ENV_PREFIX}}SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
{{ENV_PREFIX}}SUPABASE_ANON_KEY=YOUR-ANON-KEY
{{ENV_PREFIX}}SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
{{ENV_PREFIX}}APP_URL=http://localhost:5173

# Server-side only - used by the RLS isolation test suite. NEVER add a client-exposed prefix.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
